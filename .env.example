NEXT_PUBLIC_API_BASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=


NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_CLERK_SIGN_UP_FALLBACK_URL=/
NEXT_CLERK_SIGN_IN_FALLBACK_URL=/

# Vercel Blob. Company logos and applicant résumés are uploaded through it;
# without this, every upload fails and the field is simply left unset.
BLOB_READ_WRITE_TOKEN=

# Signs the reference the upload route hands back to the browser, which the save
# action redeems. Without it uploads fail closed — an unsigned reference would
# let a client name any URL as its résumé, and the download routes fetch
# whatever is stored. Generate with: openssl rand -base64 32
UPLOAD_SIGNING_SECRET=