{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": [
    "next/core-web-vitals",
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@next/next/recommended",
    "prettier",
    "plugin:prettier/recommended"
  ],
  "plugins": [
    "react",
    "react-hooks",
    "@typescript-eslint",
    "prettier",
    "simple-import-sort"
  ],
  "rules": {
    "prettier/prettier": "error",
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "react/jsx-filename-extension": [1, { "extensions": [".jsx", ".tsx"] }],
    "react/jsx-no-target-blank": "warn",
    "simple-import-sort/imports": "error",
    "simple-import-sort/exports": "error",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "extends": ["plugin:@typescript-eslint/recommended-type-checked"],
      "parserOptions": {
        "project": ["./tsconfig.json"]
      },
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "warn",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrors": "none"
          }
        ],
        "@typescript-eslint/consistent-type-imports": [
          "error",
          { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
        ],
        "@typescript-eslint/no-floating-promises": "error",
        "@typescript-eslint/no-misused-promises": [
          "error",
          { "checksVoidReturn": { "attributes": false } }
        ],
        "@typescript-eslint/await-thenable": "error",
        "@typescript-eslint/require-await": "off",
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/restrict-template-expressions": "warn",
        "@typescript-eslint/no-unnecessary-type-assertion": "warn",
        "@typescript-eslint/no-redundant-type-constituents": "warn",
        "@typescript-eslint/no-base-to-string": "warn",
        "@typescript-eslint/no-unsafe-assignment": "warn",
        "@typescript-eslint/no-unsafe-member-access": "warn",
        "@typescript-eslint/no-unsafe-call": "warn",
        "@typescript-eslint/no-unsafe-argument": "warn",
        "@typescript-eslint/no-unsafe-return": "warn"
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/entities/*",
                  "@/entities/**",
                  "@/features/*",
                  "@/features/**",
                  "@/widgets/*",
                  "@/widgets/**",
                  "@/views/*",
                  "@/views/**",
                  "@/app/*",
                  "@/app/**"
                ],
                "message": "FSD: `shared` is the bottom layer and may not import from any layer above it. Move the domain-aware part up into the entity or feature that owns it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/*",
                  "@/features/**",
                  "@/widgets/*",
                  "@/widgets/**",
                  "@/views/*",
                  "@/views/**",
                  "@/app/*",
                  "@/app/**"
                ],
                "message": "FSD: `entities` may only import from `shared`. Anything that needs a feature or widget belongs in a higher layer."
              },
              {
                "group": [
                  "@/entities/*/ui/**",
                  "@/entities/*/model/**",
                  "@/entities/*/api/**",
                  "@/entities/*/lib/**"
                ],
                "message": "FSD: import another entity through its public API (`@/entities/<slice>` or `@/entities/<slice>/client`), not its internal segments."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/widgets/*",
                  "@/widgets/**",
                  "@/views/*",
                  "@/views/**",
                  "@/app/*",
                  "@/app/**"
                ],
                "message": "FSD: `features` may only import from `entities` and `shared`. Reusable logic that a widget also needs belongs in `shared` or its own feature."
              },
              {
                "group": [
                  "@/features/*/*/ui/**",
                  "@/features/*/*/model/**",
                  "@/features/*/*/api/**",
                  "@/features/*/*/lib/**"
                ],
                "message": "FSD: import another feature through its public API (`index` or `client`), not its internal segments."
              },
              {
                "group": [
                  "@/entities/*/ui/**",
                  "@/entities/*/model/**",
                  "@/entities/*/api/**",
                  "@/entities/*/lib/**"
                ],
                "message": "FSD: import entities through their public API — `@/entities/<slice>`, or `@/entities/<slice>/client` from a client component."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/widgets/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/views/*", "@/views/**", "@/app/*", "@/app/**"],
                "message": "FSD: `widgets` may only import from `features`, `entities`, and `shared`."
              },
              {
                "group": [
                  "@/widgets/*/ui/**",
                  "@/widgets/*/model/**",
                  "@/widgets/*/api/**",
                  "@/widgets/*/lib/**",
                  "@/features/*/*/ui/**",
                  "@/features/*/*/model/**",
                  "@/features/*/*/api/**",
                  "@/features/*/*/lib/**",
                  "@/entities/*/ui/**",
                  "@/entities/*/model/**",
                  "@/entities/*/api/**",
                  "@/entities/*/lib/**"
                ],
                "message": "FSD: import slices through their public API (`index` or `client`), not their internal segments."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/views/**", "src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/views/*/ui/**",
                  "@/widgets/*/ui/**",
                  "@/widgets/*/model/**",
                  "@/widgets/*/api/**",
                  "@/widgets/*/lib/**",
                  "@/features/*/*/ui/**",
                  "@/features/*/*/model/**",
                  "@/features/*/*/api/**",
                  "@/features/*/*/lib/**",
                  "@/entities/*/ui/**",
                  "@/entities/*/model/**",
                  "@/entities/*/api/**",
                  "@/entities/*/lib/**"
                ],
                "message": "FSD: import slices through their public API (`index` or `client`), not their internal segments."
              },
              {
                "group": ["@/shared/lib/prisma"],
                "message": "FSD: routing and page composition must not reach the database directly. Add a query to the entity that owns the data and call that instead."
              }
            ]
          }
        ]
      }
    }
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "build/",
    "out/",
    "next-env.d.ts",
    "*.config.js",
    "*.config.mjs"
  ]
}
