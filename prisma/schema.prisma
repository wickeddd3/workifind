// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // `fullTextSearch` is gone: its `search` filter compiled to an expression
  // Postgres cannot index. Job search now goes through the `searchVector`
  // generated column and its GIN index — see job.service.ts.
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum Role {
  EMPLOYER
  APPLICANT
}

model Employer {
  id             String   @id @default(uuid())
  slug           String   @unique
  companyName    String
  companyEmail   String?
  companyWebsite String?
  companyLogoUrl String?
  industry       String?
  location       String?
  about          String?
  pitch          String?
  perks          Json
  userId         String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]

  @@index([createdAt(sort: Desc)])
  // Job search filters by industry through this relation, so the planner needs
  // to narrow employers by it before joining.
  @@index([industry])
  @@map("employers")
}

model Applicant {
  id                       String                   @id @default(uuid())
  firstName                String
  lastName                 String
  email                    String
  phoneNumber              String?
  location                 String?
  about                    String?
  profession               String
  experienced              String
  skills                   Json
  languages                Json
  availability             String
  preferredEmploymentTypes String[]
  preferredLocationTypes   String[]
  preferredLocations       Json
  salaryExpectation        Int
  userId                   String                   @unique
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  jobApplications          JobApplication[]
  savedJobs                SavedJob[]
  experiences              ApplicantExperience[]
  educations               ApplicantEducation[]
  certifications           ApplicantCertification[]

  @@index([createdAt(sort: Desc)])
  @@map("applicants")
}

// The three CV record types below are rows rather than Json columns — unlike
// `skills` and `languages`, which are bare names. Each has several typed fields
// and a date the profile is ordered by, and a `startDate` inside a Json blob is
// a string no query can sort on.
//
// `onDelete: Cascade` is what lets `prisma.applicant.deleteMany` still work in
// the seed cleanup, which deletes profiles by their owner's userId — these rows
// carry no userId of their own to be scoped by.
//
// Dates are stored as the first of the month in UTC: a CV states "March 2024",
// not a day, and anchoring to UTC keeps the stored month from shifting under a
// reader in a different timezone. See `shared/utils/format-month.ts`.

model ApplicantExperience {
  id             String    @id @default(uuid())
  title          String
  company        String
  employmentType String?
  location       String?
  startDate      DateTime
  endDate        DateTime?
  /// Set when the role is ongoing, in which case `endDate` is null.
  current        Boolean   @default(false)
  description    String?
  applicant      Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Always read as one applicant's whole history, newest first.
  @@index([applicantId, current(sort: Desc), startDate(sort: Desc)])
  @@map("applicant_experiences")
}

model ApplicantEducation {
  id           String    @id @default(uuid())
  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  /// Set while still studying, in which case `endDate` is null.
  current      Boolean   @default(false)
  description  String?
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([applicantId, current(sort: Desc), startDate(sort: Desc)])
  @@map("applicant_educations")
}

model ApplicantCertification {
  id            String    @id @default(uuid())
  name          String
  issuer        String?
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  applicant     Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([applicantId, issueDate(sort: Desc)])
  @@map("applicant_certifications")
}

model Job {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  employmentType  String
  locationType    String
  location        String?
  description     String?
  minSalary       Int
  maxSalary       Int
  approved        Boolean          @default(true)
  closed          Boolean          @default(false)
  userId          String
  employer        Employer         @relation(fields: [employerId], references: [id])
  employerId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobApplications JobApplication[]
  savedJobs       SavedJob[]

  // Stored generated column maintained by Postgres — see the
  // add_job_search_vector migration. Prisma cannot express `tsvector`, so it is
  // declared Unsupported and queried through $queryRaw in job.service.ts.
  searchVector Unsupported("tsvector")?

  // Public job search: filters on `approved`, then sorts by recency.
  @@index([approved, createdAt(sort: Desc)])
  // Employer dashboard: an employer's own posts, most recent first.
  @@index([userId, createdAt(sort: Desc)])
  // Facet filters — the planner can bitmap-AND these with the index above.
  @@index([employmentType])
  @@index([locationType])
  @@index([employerId])
  @@map("jobs")
}

model JobApplication {
  id          String    @id @default(uuid())
  pitch       String
  userId      String
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  applicantId String
  job         Job       @relation(fields: [jobId], references: [id])
  jobId       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // `checkIfAlreadyApplied` looks up by (userId, jobId) on every job page.
  @@index([userId, jobId])
  @@index([jobId])
  @@index([applicantId])
  @@map("job_applications")
}

model SavedJob {
  id          String    @id @default(uuid())
  userId      String
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  applicantId String
  job         Job       @relation(fields: [jobId], references: [id])
  jobId       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // `checkIfAlreadySaved` looks up by (userId, jobId) on every job page.
  @@index([userId, jobId])
  @@index([jobId])
  @@index([applicantId])
  @@map("saved_jobs")
}
