// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // `fullTextSearch` is gone: its `search` filter compiled to an expression
  // Postgres cannot index. Job search now goes through the `searchVector`
  // generated column and its GIN index — see job.service.ts.
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum Role {
  EMPLOYER
  APPLICANT
}

model Employer {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  companyName    String
  companyEmail   String?
  companyWebsite String?
  companyLogoUrl String?
  industry       String?
  location       String?
  about          String?
  pitch          String?
  perks          Json
  userId         String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]

  @@index([createdAt(sort: Desc)])
  @@map("employers")
}

model Applicant {
  id                       Int              @id @default(autoincrement())
  firstName                String
  lastName                 String
  email                    String
  phoneNumber              String?
  location                 String?
  about                    String?
  profession               String
  experienced              String
  skills                   Json
  languages                Json
  availability             String
  preferredEmploymentTypes String[]
  preferredLocationTypes   String[]
  preferredLocations       Json
  salaryExpectation        Int
  userId                   String           @unique
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  jobApplications          JobApplication[]
  savedJobs                SavedJob[]

  @@index([createdAt(sort: Desc)])
  @@map("applicants")
}

model Job {
  id              Int              @id @default(autoincrement())
  slug            String           @unique
  title           String
  employmentType  String
  locationType    String
  location        String?
  description     String?
  minSalary       Int
  maxSalary       Int
  approved        Boolean          @default(true)
  closed          Boolean          @default(false)
  userId          String
  employer        Employer         @relation(fields: [employerId], references: [id])
  employerId      Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobApplications JobApplication[]
  savedJobs       SavedJob[]

  // Stored generated column maintained by Postgres — see the
  // add_job_search_vector migration. Prisma cannot express `tsvector`, so it is
  // declared Unsupported and queried through $queryRaw in job.service.ts.
  searchVector Unsupported("tsvector")?

  // Public job search: filters on `approved`, then sorts by recency.
  @@index([approved, createdAt(sort: Desc)])
  // Employer dashboard: an employer's own posts, most recent first.
  @@index([userId, createdAt(sort: Desc)])
  // Facet filters — the planner can bitmap-AND these with the index above.
  @@index([employmentType])
  @@index([locationType])
  @@index([employerId])
  @@map("jobs")
}

model JobApplication {
  id          Int       @id @default(autoincrement())
  pitch       String
  userId      String
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  applicantId Int
  job         Job       @relation(fields: [jobId], references: [id])
  jobId       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // `checkIfAlreadyApplied` looks up by (userId, jobId) on every job page.
  @@index([userId, jobId])
  @@index([jobId])
  @@index([applicantId])
  @@map("jobApplications")
}

model SavedJob {
  id          Int       @id @default(autoincrement())
  userId      String
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  applicantId Int
  job         Job       @relation(fields: [jobId], references: [id])
  jobId       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // `checkIfAlreadySaved` looks up by (userId, jobId) on every job page.
  @@index([userId, jobId])
  @@index([jobId])
  @@index([applicantId])
  @@map("savedJobs")
}
